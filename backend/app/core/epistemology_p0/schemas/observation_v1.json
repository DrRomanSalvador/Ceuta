{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceutia.local/schemas/observation/v1",
  "title": "CeutIA Observation Contract v1.0",
  "description": "Contrato versionado CeutIA → Serpiente. Ninguna salida puede perder significado, procedencia, incertidumbre, temporalidad ni estado epistemológico.",
  "type": "object",
  "required": [
    "observation_id",
    "variable",
    "value",
    "semantic_definition",
    "time",
    "source",
    "confidence",
    "epistemic_status",
    "schema_version"
  ],
  "properties": {
    "observation_id": { "type": "string" },
    "variable": { "type": "string" },
    "value": {},
    "unit": { "type": ["string", "null"] },
    "semantic_definition": { "type": "string", "minLength": 1 },
    "time": {
      "type": "object",
      "properties": {
        "event_start": { "type": ["string", "null"], "format": "date-time" },
        "event_end": { "type": ["string", "null"], "format": "date-time" },
        "publication_time": { "type": ["string", "null"], "format": "date-time" },
        "ingestion_time": { "type": ["string", "null"], "format": "date-time" },
        "revision_time": { "type": ["string", "null"], "format": "date-time" },
        "detection_time": { "type": ["string", "null"], "format": "date-time" },
        "assessment_time": { "type": ["string", "null"], "format": "date-time" },
        "impact_time": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "geography": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "required": ["source_id", "document_id", "claim_id"],
      "properties": {
        "source_id": { "type": "string" },
        "document_id": { "type": "string" },
        "claim_id": { "type": "string" }
      }
    },
    "provenance": { "type": "array" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "lower": { "type": ["number", "null"] },
        "upper": { "type": ["number", "null"] },
        "value": { "type": ["number", "null"] }
      }
    },
    "source_dependence_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "corroboration": { "type": "array" },
    "contradictions": { "type": "array" },
    "methodology": { "type": ["string", "null"] },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "OBSERVED_FACT",
        "CORROBORATED_FACT",
        "ATTRIBUTED_CLAIM",
        "INFERENCE",
        "HYPOTHESIS",
        "UNVERIFIED",
        "CONTRADICTED",
        "DISPROVEN",
        "UNKNOWN"
      ]
    },
    "schema_version": { "type": "string" },
    "emitted_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
