{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceutia.local/contracts/v1/contradiction.schema.json",
  "title": "CeutIA Contradiction Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contradiction_id", "claim_a", "claim_b", "relationship", "evidence_ids", "created_at", "schema_version"],
  "properties": {
    "contradiction_id": {"type": "string", "minLength": 1},
    "claim_a": {"type": "string", "minLength": 1},
    "claim_b": {"type": "string", "minLength": 1},
    "relationship": {"enum": ["DIRECT", "CONTEXTUAL", "TEMPORAL", "SEMANTIC", "UNKNOWN"]},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "resolution_status": {"enum": ["OPEN", "REVIEW_REQUIRED", "RESOLVED", "UNKNOWN"]},
    "resolution_basis": {"type": ["string", "null"]},
    "schema_version": {"const": "1.0.0"}
  }
}
