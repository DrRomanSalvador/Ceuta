{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceutia.local/contracts/v1/falsification-result.schema.json",
  "title": "CeutIA Falsification Result Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "target_id", "test", "outcome", "observations", "performed_at", "schema_version"],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "test": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["SUPPORTED", "FALSIFIED", "INCONCLUSIVE", "BLOCKED"]},
    "observations": {"type": "array", "items": {"type": "string"}},
    "performed_at": {"type": "string", "format": "date-time"},
    "performed_by": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"}
  }
}
