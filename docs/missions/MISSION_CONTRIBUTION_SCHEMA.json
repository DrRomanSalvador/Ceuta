{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CeutIA + SERPIENTE Mission Contribution Event",
  "type": "object",
  "required": ["event_id","event_type","mission_id","agent_instance","timestamp","artifact","provenance","result"],
  "properties": {
    "event_id": {"type":"string"},
    "event_type": {"enum":["DISCOVERY","COOPERATION","SCIENTIFIC_CORRECTION","HANDOFF","REVIEW","VALIDATION","DUPLICATION_AVOIDED","SECURITY_FINDING","REPAIR_ENABLED","NON_INTERFERENCE_COMPLIANCE"]},
    "mission_id": {"type":"string"},
    "agent_instance": {"type":"string"},
    "timestamp": {"type":"string"},
    "discovered_by": {"type":["string","null"]},
    "proposed_by": {"type":["string","null"]},
    "implemented_by": {"type":["string","null"]},
    "reviewed_by": {"type":["string","null"]},
    "validated_by": {"type":["string","null"]},
    "parent_task": {"type":["string","null"]},
    "artifact": {"type":"string"},
    "repository_revision": {"type":["string","null"]},
    "provenance": {"type":"array","items":{"type":"string"}},
    "evidence_status": {"type":"string"},
    "result": {"type":"string"},
    "limitations": {"type":"array","items":{"type":"string"}},
    "next_action": {"type":["string","null"]}
  },
  "additionalProperties": false
}
