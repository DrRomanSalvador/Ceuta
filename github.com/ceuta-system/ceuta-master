"""
CEUTA MASTER CODE - VERSIÓN FINAL
Fórmula + Código + Ejecución Inmediata
Sin excusas. Sin límites.
"""

import numpy as np
import json
import hashlib
from datetime import datetime

# PESOS PÚBLICOS (auditables)
W = {
    'capability_growth': 0.25,
    'incident_count': 0.20,
    'governance_gap': 0.20,
    'awareness_level': -0.15,
    'international_cooperation': -0.20
}

# UMBRALES
THRESHOLDS = {'green': 0.4, 'yellow': 0.6, 'orange': 0.75}

def sigmoid(x):
    return 1.0 / (1.0 + np.exp(-x))

def calculate():
    # DATOS ACTUALES (ejemplo - reemplazar con APIs reales)
    X = {
        'capability_growth': 0.65,
        'incident_count': 0.45,
        'governance_gap': 0.70,
        'awareness_level': 0.35,
        'international_cooperation': 0.40
    }
    
    # FÓRMULA MAESTRA
    raw = sum(W[k] * X[k] for k in W)
    R = sigmoid(raw)
    
    # INCERTIDUMBRE
    n = len(X)
    se = np.sqrt(R * (1-R) / n) if n >= 2 else 0.5
    ci = [max(0, R - 1.96*se), min(1, R + 1.96*se)]
    
    # ALERTA
    level = 'GREEN' if R < THRESHOLDS['green'] else \
            'YELLOW' if R < THRESHOLDS['yellow'] else \
            'ORANGE' if R < THRESHOLDS['orange'] else 'RED'
    
    # AUDITORÍA
    audit_hash = hashlib.sha256(f"{R}{ci}{json.dumps(X)}".encode()).hexdigest()[:16]
    
    return {
        'risk': round(R, 4),
        'ci_95': [round(ci[0], 4), round(ci[1], 4)],
        'level': level,
        'components': X,
        'audit_hash': audit_hash,
        'timestamp': datetime.utcnow().isoformat() + 'Z'
    }

if __name__ == '__main__':
    result = calculate()
    print(json.dumps(result, indent=2))
    
    # GUARDAR
    with open(f"ceuta_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}.json", 'w') as f:
        json.dump(result, f, indent=2)
    
    print(f"\n✅ Riesgo: {result['risk']:.4f} ({result['level']})")
    print(f"📊 IC 95%: {result['ci_95']}")
    print(f"🔐 Audit: {result['audit_hash']}")



"""
